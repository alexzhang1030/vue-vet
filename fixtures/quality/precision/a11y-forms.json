{
  "project": "a11y-forms",
  "findings": [
    {
      "rule_id": "vue-vet/accessibility/form-control-has-label",
      "file": "OrphanControls.vue",
      "classification": "true_positive",
      "rationale": "Orphan text input and textarea lack nesting, for/id, or aria name"
    },
    {
      "rule_id": "vue-vet/accessibility/label-has-for",
      "file": "BareLabel.vue",
      "classification": "true_positive",
      "rationale": "Bare label has neither for nor a nested labelable control"
    },
    {
      "rule_id": "vue-vet/accessibility/heading-has-content",
      "file": "EmptyHeading.vue",
      "classification": "true_positive",
      "rationale": "Empty h2 has no accessible content"
    },
    {
      "rule_id": "vue-vet/accessibility/anchor-has-content",
      "file": "IconLink.vue",
      "classification": "true_positive",
      "rationale": "Icon-only anchor has children but no accessible name"
    },
    {
      "rule_id": "vue-vet/accessibility/button-has-content",
      "file": "EmptyButton.vue",
      "classification": "true_positive",
      "rationale": "Icon-only button has children but no accessible name"
    },
    {
      "rule_id": "vue-vet/accessibility/click-events-have-key-events",
      "file": "ClickOnly.vue",
      "classification": "true_positive",
      "rationale": "Clickable div without keyboard handler"
    },
    {
      "rule_id": "vue-vet/accessibility/no-autofocus",
      "file": "AutofocusField.vue",
      "classification": "true_positive",
      "rationale": "Boolean autofocus on an otherwise named input"
    },
    {
      "rule_id": "vue-vet/accessibility/iframe-has-title",
      "file": "BareIframe.vue",
      "classification": "true_positive",
      "rationale": "iframe missing title"
    },
    {
      "rule_id": "vue-vet/accessibility/no-distracting-elements",
      "file": "Marquee.vue",
      "classification": "true_positive",
      "rationale": "marquee is a distracting element"
    },
    {
      "rule_id": "vue-vet/accessibility/img-has-alt",
      "file": "BareImg.vue",
      "classification": "true_positive",
      "rationale": "img missing alt"
    },
    {
      "rule_id": "vue-vet/accessibility/no-aria-hidden-on-focusable",
      "file": "HiddenButton.vue",
      "classification": "true_positive",
      "rationale": "Focusable button marked aria-hidden"
    },
    {
      "rule_id": "vue-vet/accessibility/no-positive-tabindex",
      "file": "PositiveTab.vue",
      "classification": "true_positive",
      "rationale": "Positive tabindex disrupts focus order"
    },
    {
      "rule_id": "vue-vet/accessibility/valid-aria-role",
      "file": "BadRole.vue",
      "classification": "true_positive",
      "rationale": "Invalid ARIA role token"
    },
    {
      "rule_id": "vue-vet/maintainability/no-redundant-role",
      "file": "BadRole.vue",
      "classification": "true_positive",
      "rationale": "Native button with redundant role=button"
    }
  ]
}

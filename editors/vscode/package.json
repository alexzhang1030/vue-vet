{
  "name": "vue-vet",
  "displayName": "Vue Vet Reactivity",
  "description": "Thin VS Code host that visualizes Vue Vet static reactivity traces in the editor.",
  "version": "0.1.16",
  "publisher": "vue-vet",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "vue",
    "nuxt",
    "reactivity",
    "vue-vet"
  ],
  "activationEvents": [
    "onView:vueVet.reactivity",
    "onCommand:vue-vet.showReactivity",
    "onCommand:vue-vet.refreshReactivity",
    "onLanguage:vue",
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vue-vet.showReactivity",
        "title": "Vue Vet: Show Reactivity",
        "icon": "$(graph)"
      },
      {
        "command": "vue-vet.refreshReactivity",
        "title": "Vue Vet: Refresh Reactivity",
        "icon": "$(refresh)"
      },
      {
        "command": "vue-vet.clearReactivity",
        "title": "Vue Vet: Clear Reactivity Highlights"
      },
      {
        "command": "vue-vet.showReaders",
        "title": "Vue Vet: Show Who Reads This"
      },
      {
        "command": "vue-vet.showDependencies",
        "title": "Vue Vet: Show Dependencies"
      },
      {
        "command": "vue-vet.showComponentsUsed",
        "title": "Vue Vet: Show Components Used"
      },
      {
        "command": "vue-vet.showComponentUsers",
        "title": "Vue Vet: Show Component Users"
      }
    ],
    "configuration": {
      "title": "Vue Vet",
      "properties": {
        "vue-vet.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the vue-vet binary. Empty prefers workspace target/debug|release/vue-vet, then PATH, then npx @vue-vet/cli."
        },
        "vue-vet.refreshOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Re-run reactivity tracing when a workspace Vue/JS/TS file is saved."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vue-vet",
          "title": "Vue Vet",
          "icon": "media/vue-vet.svg"
        }
      ]
    },
    "views": {
      "vue-vet": [
        {
          "id": "vueVet.reactivity",
          "name": "Reactivity"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vue-vet.showReactivity",
          "when": "view == vueVet.reactivity",
          "group": "navigation"
        },
        {
          "command": "vue-vet.refreshReactivity",
          "when": "view == vueVet.reactivity",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vue-vet.showReaders",
          "when": "view == vueVet.reactivity && viewItem == binding",
          "group": "inline"
        },
        {
          "command": "vue-vet.showDependencies",
          "when": "view == vueVet.reactivity && viewItem == binding",
          "group": "inline"
        },
        {
          "command": "vue-vet.showComponentsUsed",
          "when": "view == vueVet.reactivity && viewItem == module",
          "group": "inline"
        },
        {
          "command": "vue-vet.showComponentUsers",
          "when": "view == vueVet.reactivity && viewItem == module",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "vue-vet.showReaders",
          "when": "resourceExtname == .vue || resourceLangId == typescript || resourceLangId == javascript",
          "group": "vue-vet@1"
        },
        {
          "command": "vue-vet.showDependencies",
          "when": "resourceExtname == .vue || resourceLangId == typescript || resourceLangId == javascript",
          "group": "vue-vet@2"
        },
        {
          "command": "vue-vet.showComponentsUsed",
          "when": "resourceExtname == .vue",
          "group": "vue-vet@3"
        },
        {
          "command": "vue-vet.showComponentUsers",
          "when": "resourceExtname == .vue",
          "group": "vue-vet@4"
        }
      ]
    },
    "colors": [
      {
        "id": "vueVet.bindingHighlight",
        "description": "Background for reactive binding spans",
        "defaults": {
          "dark": "#e2b71433",
          "light": "#c9a22733",
          "highContrast": "#e2b71466"
        }
      },
      {
        "id": "vueVet.edgeHighlight",
        "description": "Background for reactivity edge / reader spans",
        "defaults": {
          "dark": "#3b82f633",
          "light": "#2563eb33",
          "highContrast": "#3b82f666"
        }
      },
      {
        "id": "vueVet.selectionHighlight",
        "description": "Background for the currently selected edge endpoints",
        "defaults": {
          "dark": "#22c55e55",
          "light": "#16a34a44",
          "highContrast": "#22c55e88"
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0"
  }
}
